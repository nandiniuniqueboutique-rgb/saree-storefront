# Copy this file to .env for local use (never commit .env). On Render, enter these in the service's Environment tab.

# --- Server ---
PORT=3000
NODE_ENV=development            # "production" on the live server
DATA_DIR=./data                 # database + photos. On Render: /var/data (the persistent disk)

# --- Shop ---
STORE_NAME=Nandini Unique Boutique
WHATSAPP_NUMBER=917411211052    # country code + number, digits only; used for the chat button
SHIPPING_FEE=0                  # rupees added to every order
FREE_SHIPPING_ABOVE=0           # orders at or above this get free delivery; 0 = never
COD_ENABLED=false               # true adds a "Cash on delivery" option next to online payment

# --- Owner login (first start only) ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=                 # at least 10 characters. Remove it after your first sign-in.
# RESET_ADMIN_PASSWORD=true     # forgot the password? set this with the two lines above, restart, then remove all three

# --- Razorpay (https://dashboard.razorpay.com) ---
RAZORPAY_KEY_ID=                # rzp_test_... while testing, rzp_live_... when real payments start
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # the secret you type when adding the webhook in the Razorpay dashboard

# --- Advanced ---
# SEED_SAMPLE_PRODUCTS=true     # load the placeholder catalog from seed/products.json (development only; off in production)
# SESSION_HOURS=12
# TRUST_PROXY=true              # defaults to true in production (the host's proxy sits in front of the app)
# CLIENT_IP_HEADER=             # e.g. cf-connecting-ip if visitors all appear to share one IP in the logs
# SECURE_COOKIES=true           # defaults to true in production
